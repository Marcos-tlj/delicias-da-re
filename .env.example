# Copie este arquivo para .env.local e preencha (NUNCA suba o .env.local para o GitHub)
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# "Publishable key" (sb_publishable_...) ou a antiga "anon public key".
# Ela é pública por natureza: quem protege os dados é o RLS.
# NUNCA use a service_role / secret key neste projeto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica

# WhatsApp da confeitaria (só números, com 55 + DDD)
NEXT_PUBLIC_WHATSAPP=5514997630070
# Chave PIX mostrada ao cliente depois do pedido (telefone, e-mail, CPF/CNPJ ou aleatória)
NEXT_PUBLIC_PIX_KEY=
